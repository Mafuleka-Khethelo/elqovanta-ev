# Copy this file to .env in the project root. Do not commit .env.

# PostgreSQL connection used by the API, migrations and operator commands.
# The password below matches docker-compose.yml and the local quick-start script.
DATABASE_URL=postgresql+psycopg://chargeconnect:chargeconnect@127.0.0.1:5432/chargeconnect

# development | test | production
# seed-demo refuses to run when ENVIRONMENT=production.
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API with cookies.
# The Vite dev server proxies /api, so these are only needed for direct API use.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true only for an HTTPS deployment. Local HTTP must keep this false
# or the browser will ignore the login cookie.
COOKIE_SECURE=false

# Cloud deployment enables these; local Vite development can leave them false.
SERVE_FRONTEND=false
FRONTEND_PATH=../frontend/dist
INITIALIZE_DATABASE=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Paths are relative to the backend directory unless they are absolute.
# The original bundle in the project root is copied here on startup if needed.
ARTIFACT_PATH=artifacts/ev_charger_bundle.joblib
ENVIRONMENT_MANIFEST_PATH=artifacts/model_environment.json

# Required only for: python -m app.cli seed-demo
# Use a phrase of 10–128 characters. It is the password for the four
# labelled demonstration accounts and is never given a built-in default.
DEMO_PASSWORD=

# Local CLI provisioning only. These are not public signup settings.
MANAGER_PASSWORD=
RESEARCHER_PASSWORD=
